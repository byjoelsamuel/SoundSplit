<!-- Midnight: dark chat-app style greys with a soft indigo accent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Font.Main">pack://application:,,,/Assets/Fonts/#Nunito</FontFamily>
    <FontFamily x:Key="Font.Title">pack://application:,,,/Assets/Fonts/#Nunito</FontFamily>

    <CornerRadius x:Key="Radius.Card">18</CornerRadius>
    <CornerRadius x:Key="Radius.Tile">14</CornerRadius>
    <CornerRadius x:Key="Radius.Button">17</CornerRadius>
    <CornerRadius x:Key="Radius.Round">20</CornerRadius>
    <CornerRadius x:Key="Radius.Switch">14</CornerRadius>
    <CornerRadius x:Key="Radius.Thumb">11</CornerRadius>
    <Thickness x:Key="Thickness.Border">1</Thickness>
    <Visibility x:Key="Show.Bubbles">Collapsed</Visibility>

    <SolidColorBrush x:Key="Brush.Window" Color="#FF1E1F22" />
    <SolidColorBrush x:Key="Brush.WindowBorder" Color="#FF3F4147" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#FF1A1B1E" />
    <SolidColorBrush x:Key="Brush.TitleText" Color="#FFF2F3F5" />

    <SolidColorBrush x:Key="Brush.Card" Color="#FF2B2D31" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#FF383A40" />
    <SolidColorBrush x:Key="Brush.CardShine" Color="#00FFFFFF" />
    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2E3036" Offset="0" />
        <GradientStop Color="#FF2A2D45" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Text" Color="#FFF2F3F5" />
    <SolidColorBrush x:Key="Brush.SubText" Color="#FFB5BAC1" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#FF5865F2" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="#FF4752C4" />

    <SolidColorBrush x:Key="Brush.Button" Color="#FF383A40" />
    <SolidColorBrush x:Key="Brush.ButtonBorder" Color="#FF4E5058" />
    <SolidColorBrush x:Key="Brush.ButtonText" Color="#FFDBDEE1" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="Brush.Gloss" Color="#00FFFFFF" />

    <SolidColorBrush x:Key="Brush.Field" Color="#FF1E1F22" />
    <SolidColorBrush x:Key="Brush.FieldBorder" Color="#FF3F4147" />
    <SolidColorBrush x:Key="Brush.Popup" Color="#FF111214" />
    <SolidColorBrush x:Key="Brush.PopupBorder" Color="#FF3F4147" />
    <SolidColorBrush x:Key="Brush.ItemHover" Color="#FF35373C" />
    <SolidColorBrush x:Key="Brush.ItemSelected" Color="#FF404249" />

    <SolidColorBrush x:Key="Brush.SwitchOff" Color="#FF80848E" />
    <SolidColorBrush x:Key="Brush.SwitchOn" Color="#FF23A55A" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Brush.Track" Color="#FF4E5058" />
    <SolidColorBrush x:Key="Brush.TrackFill" Color="#FF5865F2" />

    <SolidColorBrush x:Key="Brush.Chip" Color="#3323A55A" />
    <SolidColorBrush x:Key="Brush.ChipText" Color="#FF57F287" />
    <SolidColorBrush x:Key="Brush.Good" Color="#FF23A55A" />

    <SolidColorBrush x:Key="Brush.IconTile" Color="#FF5865F2" />
    <SolidColorBrush x:Key="Brush.IconTileText" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#FFDA373C" />
    <SolidColorBrush x:Key="Brush.DangerText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#A6000000" />
    <SolidColorBrush x:Key="Brush.Toast" Color="#FF111214" />
    <SolidColorBrush x:Key="Brush.ToastText" Color="#FFFFFFFF" />

    <DropShadowEffect x:Key="Effect.Card" Color="#FF000000" BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.35" />
</ResourceDictionary>

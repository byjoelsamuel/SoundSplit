<Window x:Class="SoundSplit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SoundSplit"
        xmlns:vm="clr-namespace:SoundSplit.ViewModels"
        Title="SoundSplit"
        Width="1040" Height="680" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{DynamicResource Font.Main}"
        Foreground="{DynamicResource Brush.Text}"
        FontSize="13.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/SoundSplit.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- A device inside the dropdowns -->
        <DataTemplate x:Key="DeviceOptionTemplate" DataType="{x:Type vm:DeviceOption}">
            <DockPanel>
                <local:IconBox Data="{Binding Glyph}" Width="15" Height="15" DockPanel.Dock="Left"
                               Foreground="{DynamicResource Brush.SubText}" VerticalAlignment="Center" />
                <TextBlock x:Name="Lbl" Text="{Binding Label}" Margin="9,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Lbl" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.SubText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{DynamicResource Brush.WindowBorder}" BorderThickness="1">
        <Grid x:Name="Root">

            <!-- Aero theme only: decorative bubbles -->
            <Canvas IsHitTestVisible="False" Visibility="{DynamicResource Show.Bubbles}" ClipToBounds="True">
                <Canvas.Resources>
                    <RadialGradientBrush x:Key="Bubble" GradientOrigin="0.35,0.3" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#CCFFFFFF" Offset="0" />
                        <GradientStop Color="#33FFFFFF" Offset="0.55" />
                        <GradientStop Color="#55BDEBFF" Offset="0.92" />
                        <GradientStop Color="#99FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Canvas.Resources>
                <Ellipse Canvas.Left="-60" Canvas.Top="380" Width="220" Height="220" Fill="{StaticResource Bubble}" Opacity="0.6" />
                <Ellipse Canvas.Left="900" Canvas.Top="420" Width="260" Height="260" Fill="{StaticResource Bubble}" Opacity="0.5" />
                <Ellipse Canvas.Left="610" Canvas.Top="560" Width="60" Height="60" Fill="{StaticResource Bubble}" Opacity="0.7" />
            </Canvas>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ======================================================= Title bar -->
                <Border Background="{DynamicResource Brush.TitleBar}">
                    <DockPanel Margin="16,0,8,0" LastChildFill="False">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="22" Height="22"
                               DockPanel.Dock="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="SoundSplit" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Title}" FontWeight="Bold" FontSize="14.5"
                                   Foreground="{DynamicResource Brush.TitleText}" />

                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnClose}" ToolTip="Close"
                                Click="OnCloseClick" WindowChrome.IsHitTestVisibleInChrome="True">
                            <local:IconBox Data="{StaticResource I.X}" Width="14" Height="14" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnChrome}" ToolTip="Minimise"
                                Click="OnMinimizeClick" WindowChrome.IsHitTestVisibleInChrome="True">
                            <local:IconBox Data="{StaticResource I.Minus}" Width="14" Height="14" />
                        </Button>
                        <Rectangle DockPanel.Dock="Right" Width="1" Height="16" Margin="8,0,6,0"
                                   Fill="{DynamicResource Brush.TitleText}" Opacity="0.15" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnChrome}" ToolTip="Settings"
                                Command="{Binding ShowSettingsCommand}" WindowChrome.IsHitTestVisibleInChrome="True">
                            <local:IconBox Data="{StaticResource I.Sliders}" Width="16" Height="16" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnChrome}" ToolTip="Help"
                                Command="{Binding ShowTutorialCommand}" WindowChrome.IsHitTestVisibleInChrome="True">
                            <local:IconBox Data="{StaticResource I.Help}" Width="16" Height="16" />
                        </Button>
                    </DockPanel>
                </Border>

                <!-- ======================================================= Content -->
                <Grid Grid.Row="1" Margin="20,4,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header: what it does + master switch -->
                    <ContentControl Style="{StaticResource HeroCard}" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="{DynamicResource Radius.Tile}"
                                    Background="{DynamicResource Brush.IconTile}" VerticalAlignment="Center">
                                <local:IconBox Data="{StaticResource I.Split}" Width="20" Height="20"
                                               Foreground="{DynamicResource Brush.IconTileText}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource H2}" Text="Separate app sound" FontSize="16" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,0">
                                    <Run Text="Route selected apps to another output. Everything else stays on" />
                                    <Run Text="{Binding DefaultDeviceName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="." />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Sub}" TextWrapping="NoWrap"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ToggleButton Style="{StaticResource Switch}"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding IsSupported}"
                                              AutomationProperties.Name="Routing on or off" />
                            </StackPanel>
                        </Grid>
                    </ContentControl>

                    <!-- Not supported -->
                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="14,10" CornerRadius="{DynamicResource Radius.Tile}"
                            Background="{DynamicResource Brush.Danger}"
                            Visibility="{Binding IsSupported, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Text="{Binding SupportMessage}" />
                    </Border>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <!-- Apps -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="2,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" MinHeight="30" Padding="10,0"
                                        Command="{Binding OpenAddAppCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <local:IconBox Data="{StaticResource I.Plus}" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Add app" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Apps" FontSize="15" FontWeight="Bold" />
                                    <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="7,0">
                                        <TextBlock Text="{Binding Apps.Count}" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.ChipText}" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <ContentControl Grid.Row="1" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                                <Grid>
                                    <!-- Empty state -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                                Visibility="{Binding HasApps, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                        <Border Width="48" Height="48" CornerRadius="{DynamicResource Radius.Round}" HorizontalAlignment="Center"
                                                Background="{DynamicResource Brush.IconTile}">
                                            <local:IconBox Data="{StaticResource I.Music}" Width="22" Height="22"
                                                           Foreground="{DynamicResource Brush.IconTileText}" />
                                        </Border>
                                        <TextBlock Text="No apps yet" FontWeight="Bold" FontSize="14.5" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                        <TextBlock Style="{StaticResource Sub}" TextAlignment="Center" MaxWidth="320" Margin="0,4,0,0"
                                                   Text="Apps appear here when they play audio. You can also add one manually." />
                                    </StackPanel>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding HasApps, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding Apps}" Focusable="False" Margin="0,-1,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AppItem}">
                                                    <Border x:Name="Row" Padding="16,12" Background="Transparent"
                                                            BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="162" />
                                                                <ColumnDefinition Width="210" />
                                                                <ColumnDefinition Width="36" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- App icon -->
                                                            <Grid Width="32" Height="32" VerticalAlignment="Center">
                                                                <Image Source="{Binding Icon}" Width="28" Height="28"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                                                <Border CornerRadius="{DynamicResource Radius.Tile}" Background="{DynamicResource Brush.IconTile}"
                                                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                                    <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Bold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource Brush.IconTileText}" />
                                                                </Border>
                                                            </Grid>

                                                            <!-- Name + status -->
                                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                                    <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,0"
                                                                            Visibility="{Binding IsRouted, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="Routed" FontSize="10.5" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource Brush.ChipText}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                             Fill="{DynamicResource Brush.SubText}" Opacity="0.45" />
                                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Sub}" FontSize="12"
                                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Volume -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                                <ToggleButton Style="{StaticResource BtnIcon}" Width="28" Height="28"
                                                                              IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip="Mute">
                                                                    <local:IconBox x:Name="MuteIcon" Data="{StaticResource I.Volume}" Width="16" Height="16" />
                                                                </ToggleButton>
                                                                <Slider Style="{StaticResource Slider}" Width="80" Margin="6,0,8,0" VerticalAlignment="Center"
                                                                        Value="{Binding Volume, Mode=TwoWay}" ToolTip="App volume" />
                                                                <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" Style="{StaticResource Sub}"
                                                                           FontSize="12" VerticalAlignment="Center" Width="38" TextWrapping="NoWrap" />
                                                            </StackPanel>

                                                            <!-- Output / mic -->
                                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                                <ComboBox Style="{StaticResource Combo}"
                                                                          ItemsSource="{Binding DataContext.OutputOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          ItemTemplate="{StaticResource DeviceOptionTemplate}"
                                                                          SelectedValuePath="Id"
                                                                          SelectedValue="{Binding OutputId, Mode=TwoWay}"
                                                                          ToolTip="Output device"
                                                                          AutomationProperties.Name="Output device" />
                                                                <ComboBox Style="{StaticResource Combo}" Margin="0,6,0,0"
                                                                          ItemsSource="{Binding DataContext.InputOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          ItemTemplate="{StaticResource DeviceOptionTemplate}"
                                                                          SelectedValuePath="Id"
                                                                          SelectedValue="{Binding InputId, Mode=TwoWay}"
                                                                          ToolTip="Microphone"
                                                                          AutomationProperties.Name="Microphone"
                                                                          Visibility="{Binding DataContext.ShowMicPicker, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>

                                                            <!-- Remove (manually added apps) -->
                                                            <Button Grid.Column="4" Style="{StaticResource BtnIcon}" Width="28" Height="28"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                    ToolTip="Remove from list"
                                                                    Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                                                                <local:IconBox Data="{StaticResource I.X}" Width="14" Height="14" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter TargetName="MuteIcon" Property="Data" Value="{StaticResource I.Mute}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Good}" />
                                                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.RowHover}" />
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </ContentControl>
                        </Grid>

                        <!-- Devices -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Output devices" FontSize="15" FontWeight="Bold" Margin="2,0,0,10" MinHeight="30" Padding="0,6,0,0" />

                            <ContentControl Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="360">
                                    <ItemsControl ItemsSource="{Binding OutputDevices}" Focusable="False" Margin="0,-1,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DeviceItem}">
                                                <Border x:Name="Row" Padding="14,10" Background="Transparent"
                                                        BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="32" Height="32" CornerRadius="{DynamicResource Radius.Tile}"
                                                                Background="{DynamicResource Brush.IconTile}">
                                                            <local:IconBox Data="{Binding Glyph}" Width="16" Height="16"
                                                                           Foreground="{DynamicResource Brush.IconTileText}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                                           TextTrimming="CharacterEllipsis" />

                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" FontSize="11.5"
                                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Style="{StaticResource BtnIcon}" ToolTip="Play a test sound"
                                                                Command="{Binding DataContext.TestDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Id}">
                                                            <local:IconBox Data="{StaticResource I.Bell}" Width="16" Height="16" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.RowHover}" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </ContentControl>

                            <StackPanel Grid.Row="2" Margin="4,14,4,0">
                                <TextBlock Style="{StaticResource Sub}" FontSize="12"
                                           Text="If an app keeps playing on the old device, pause and resume it. Some apps need a restart." />
                                <Button Style="{StaticResource BtnIcon}" Width="Auto" Height="28" HorizontalAlignment="Left" Margin="-8,8,0,0"
                                        Command="{Binding OpenWindowsSoundSettingsCommand}">
                                    <StackPanel Orientation="Horizontal" Margin="8,0">
                                        <TextBlock Text="Windows sound settings" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <local:IconBox Data="{StaticResource I.External}" Width="12" Height="12" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ======================================================= Settings -->
            <Grid Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}">
                <Border Background="Transparent" MouseDown="OnBackdropClick" />
                <ContentControl Style="{StaticResource ModalCard}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,50,12,0" Width="340" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="THEME" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton Style="{StaticResource Swatch}" GroupName="Theme"
                                         Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                         IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Light}">
                                <RadioButton.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                                        <GradientStop Color="#FFFFFFFF" Offset="0.55" />
                                        <GradientStop Color="#FF4F46E5" Offset="0.56" />
                                        <GradientStop Color="#FF4F46E5" Offset="1" />
                                    </LinearGradientBrush>
                                </RadioButton.Background>
                                <TextBlock Text="Light" FontSize="11.5" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource Swatch}" GroupName="Theme"
                                         Command="{Binding SetThemeCommand}" CommandParameter="Midnight"
                                         IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Midnight}">
                                <RadioButton.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF2B2D31" Offset="0" />
                                        <GradientStop Color="#FF2B2D31" Offset="0.55" />
                                        <GradientStop Color="#FF5865F2" Offset="0.56" />
                                        <GradientStop Color="#FF5865F2" Offset="1" />
                                    </LinearGradientBrush>
                                </RadioButton.Background>
                                <TextBlock Text="Midnight" FontSize="11.5" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource Swatch}" GroupName="Theme"
                                         Command="{Binding SetThemeCommand}" CommandParameter="Aero"
                                         IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Aero}">
                                <RadioButton.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF7FD0F5" Offset="0" />
                                        <GradientStop Color="#FFB5EBB8" Offset="1" />
                                    </LinearGradientBrush>
                                </RadioButton.Background>
                                <TextBlock Text="Aero" FontSize="11.5" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource Swatch}" GroupName="Theme"
                                         Command="{Binding SetThemeCommand}" CommandParameter="Classic"
                                         IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Classic}">
                                <RadioButton.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF000080" Offset="0" />
                                        <GradientStop Color="#FF000080" Offset="0.35" />
                                        <GradientStop Color="#FFC0C0C0" Offset="0.36" />
                                        <GradientStop Color="#FF008080" Offset="1" />
                                    </LinearGradientBrush>
                                </RadioButton.Background>
                                <TextBlock Text="Classic 98" FontSize="11.5" />
                            </RadioButton>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{DynamicResource Brush.Divider}" Margin="0,16" />

                        <TextBlock Style="{StaticResource SectionLabel}" Text="GENERAL" Margin="0,0,0,10" />
                        <DockPanel Margin="0,0,0,12">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                            <StackPanel>
                                <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Sub}" FontSize="12" Text="Launch minimised to the tray at sign-in." />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                            <StackPanel>
                                <TextBlock Text="Close to tray" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Sub}" FontSize="12" Text="Keep running in the background when closed." />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowMicPicker, Mode=TwoWay}" />
                            <StackPanel>
                                <TextBlock Text="Per-app microphone" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Sub}" FontSize="12" Text="Show an input device picker for each app." />
                            </StackPanel>
                        </DockPanel>

                        <Rectangle Height="1" Fill="{DynamicResource Brush.Divider}" Margin="0,16" />

                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" MinHeight="30" Padding="10,0"
                                    Foreground="{DynamicResource Brush.Danger}" Command="{Binding AskResetAllCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <local:IconBox Data="{StaticResource I.Reset}" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Reset all" />
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Sub}" FontSize="11.5" VerticalAlignment="Center"
                                       Text="{Binding Version, StringFormat='SoundSplit {0}'}" />
                        </DockPanel>
                    </StackPanel>
                </ContentControl>
            </Grid>

            <!-- ======================================================= Add app -->
            <Grid Visibility="{Binding ShowAddApp, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource Brush.Overlay}" MouseDown="OnBackdropClick" />
                <ContentControl Style="{StaticResource ModalCard}" Width="600" MaxHeight="540" Margin="20" Padding="22">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" VerticalAlignment="Top"
                                    Command="{Binding CloseOverlaysCommand}" ToolTip="Close">
                                <local:IconBox Data="{StaticResource I.X}" Width="14" Height="14" />
                            </Button>
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Add app" FontSize="17" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,0"
                                           Text="Pick an open app, or browse for an .exe if it isn't running." />
                            </StackPanel>
                        </DockPanel>

                        <Button DockPanel.Dock="Bottom" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Command="{Binding BrowseExeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <local:IconBox Data="{StaticResource I.Folder}" Width="14" Height="14" Margin="0,0,8,0" />
                                <TextBlock Text="Browse for .exe…" />
                            </StackPanel>
                        </Button>

                        <Grid Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30"
                                       Text="No other apps with a window are open."
                                       Visibility="{Binding PickerApps.Count, Converter={StaticResource CountToVis}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding PickerApps}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PickerItem}">
                                            <Button Style="{StaticResource Tile}" Width="128" Height="100" Margin="0,0,10,10"
                                                    Command="{Binding DataContext.AddPickedAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="{Binding ExePath}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" Margin="0,8,0,0"
                                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </ContentControl>
            </Grid>

            <!-- ======================================================= Help / first run -->
            <Grid Visibility="{Binding ShowTutorial, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource Brush.Overlay}" MouseDown="OnBackdropClick" />
                <ContentControl Style="{StaticResource ModalCard}" Width="460" Margin="20" Padding="28,26">
                    <StackPanel>
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Style="{StaticResource H2}" FontSize="18" Text="Welcome to SoundSplit" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Sub}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,20"
                                   Text="Route individual apps to their own speakers or headphones." />

                        <ItemsControl Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.Chip}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Item1}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.ChipText}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                            <TextBlock Text="{Binding Item2}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Sub}" Text="{Binding Item3}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsSource>
                                <x:Array Type="{x:Type local:Step}">
                                    <local:Step Item1="1" Item2="Turn routing on" Item3="Use the switch at the top right of the window." />
                                    <local:Step Item1="2" Item2="Find the app" Item3="Apps show up when they play audio. Use Add app for anything else." />
                                    <local:Step Item1="3" Item2="Choose an output" Item3="Pick a device from the app's dropdown. The bell plays a test sound on a device." />
                                </x:Array>
                            </ItemsControl.ItemsSource>
                        </ItemsControl>

                        <Button Style="{StaticResource BtnAccent}" Content="Get started" HorizontalAlignment="Stretch"
                                Margin="0,8,0,0" MinHeight="38" Command="{Binding CloseOverlaysCommand}" />
                    </StackPanel>
                </ContentControl>
            </Grid>

            <!-- ======================================================= Reset confirm -->
            <Grid Visibility="{Binding ShowResetConfirm, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource Brush.Overlay}" MouseDown="OnBackdropClick" />
                <ContentControl Style="{StaticResource ModalCard}" Width="400" Padding="24">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" FontSize="17" Text="Reset all routing?" />
                        <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0"
                                   Text="Every app returns to the system default device, including choices made in Windows Settings. Your saved app list is cleared." />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,8,0" Command="{Binding CloseOverlaysCommand}" />
                            <Button Style="{StaticResource BtnDanger}" Content="Reset" Command="{Binding ConfirmResetAllCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Grid>

            <!-- ======================================================= Toast -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="16,9"
                    CornerRadius="{DynamicResource Radius.Button}" Background="{DynamicResource Brush.Toast}"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" />
                </Border.Effect>
                <TextBlock Text="{Binding ToastText}" Foreground="{DynamicResource Brush.ToastText}" FontSize="12.5" FontWeight="SemiBold" />
            </Border>
        </Grid>
    </Border>
</Window>

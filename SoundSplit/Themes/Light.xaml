<!-- Light: clean neutral greys with an indigo accent (default). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Font.Main">pack://application:,,,/Assets/Fonts/#Nunito</FontFamily>
    <FontFamily x:Key="Font.Title">pack://application:,,,/Assets/Fonts/#Nunito</FontFamily>

    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Tile">8</CornerRadius>
    <CornerRadius x:Key="Radius.Button">8</CornerRadius>
    <CornerRadius x:Key="Radius.Round">16</CornerRadius>
    <CornerRadius x:Key="Radius.Switch">14</CornerRadius>
    <CornerRadius x:Key="Radius.Thumb">11</CornerRadius>
    <Thickness x:Key="Thickness.Border">1</Thickness>
    <Visibility x:Key="Show.Bubbles">Collapsed</Visibility>

    <SolidColorBrush x:Key="Brush.Window" Color="#FFF4F5F7" />
    <SolidColorBrush x:Key="Brush.WindowBorder" Color="#FFD5D9E0" />
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#FFF4F5F7" />
    <SolidColorBrush x:Key="Brush.TitleText" Color="#FF101828" />

    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#FFE4E7EC" />
    <SolidColorBrush x:Key="Brush.CardShine" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="Brush.Hero" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#FFEEF0F3" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="#FFF9FAFB" />

    <SolidColorBrush x:Key="Brush.Text" Color="#FF101828" />
    <SolidColorBrush x:Key="Brush.SubText" Color="#FF667085" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#FF4F46E5" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="#FF4338CA" />

    <SolidColorBrush x:Key="Brush.Button" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.ButtonBorder" Color="#FFD0D5DD" />
    <SolidColorBrush x:Key="Brush.ButtonText" Color="#FF344054" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#0C101828" />
    <SolidColorBrush x:Key="Brush.Gloss" Color="#00FFFFFF" />

    <SolidColorBrush x:Key="Brush.Field" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.FieldBorder" Color="#FFD0D5DD" />
    <SolidColorBrush x:Key="Brush.Popup" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.PopupBorder" Color="#FFE4E7EC" />
    <SolidColorBrush x:Key="Brush.ItemHover" Color="#FFF2F4F7" />
    <SolidColorBrush x:Key="Brush.ItemSelected" Color="#FFEEF0FF" />

    <SolidColorBrush x:Key="Brush.SwitchOff" Color="#FFD0D5DD" />
    <SolidColorBrush x:Key="Brush.SwitchOn" Color="#FF4F46E5" />
    <SolidColorBrush x:Key="Brush.Thumb" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Brush.Track" Color="#FFE4E7EC" />
    <SolidColorBrush x:Key="Brush.TrackFill" Color="#FF4F46E5" />

    <SolidColorBrush x:Key="Brush.Chip" Color="#FFEEF0FF" />
    <SolidColorBrush x:Key="Brush.ChipText" Color="#FF4338CA" />
    <SolidColorBrush x:Key="Brush.Good" Color="#FF12B76A" />

    <SolidColorBrush x:Key="Brush.IconTile" Color="#FFEEF0FF" />
    <SolidColorBrush x:Key="Brush.IconTileText" Color="#FF4F46E5" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#FFD92D20" />
    <SolidColorBrush x:Key="Brush.DangerText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#59101828" />
    <SolidColorBrush x:Key="Brush.Toast" Color="#FF101828" />
    <SolidColorBrush x:Key="Brush.ToastText" Color="#FFFFFFFF" />

    <DropShadowEffect x:Key="Effect.Card" Color="#FF101828" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.05" />
</ResourceDictionary>
